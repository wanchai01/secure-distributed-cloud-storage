# PostgreSQL connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cloud_storage

# JWT
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File upload
MAX_UPLOAD_SIZE_MB=20

# Face verification (Phase 6) - illustrative default, tune with your
# own test photos. Higher = stricter (fewer false accepts, more false
# rejects). Lower = more lenient.
FACE_VERIFY_THRESHOLD=0.90

# Storage backend for uploaded files + face encodings.
# "local" (default) = write to storage/ on disk - use this for local
#   development, matches Phases 0-9 exactly.
# "r2" = write to Cloudflare R2 instead - use this when deploying to
#   a host with an ephemeral filesystem (e.g. Render's free tier).
#   Requires the 4 R2_* values below. See DEPLOYMENT.md.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# App
APP_NAME=Secure Distributed Cloud Storage
APP_ENV=development
